{
  "name": "sql-playground-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sample": "tsx src/sample/seed.ts",
    "test": "tsx --test tests/**/*.test.ts tests/**/**/*.test.ts",
    "test:parsers": "tsx --test tests/parsers/**/*.test.ts",
    "test:live": "tsx --test tests/analysis/live-engines.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "duckdb": "^1.1.3",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
